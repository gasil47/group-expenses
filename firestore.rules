rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function groupData(gid) {
      return get(/databases/$(database)/documents/groups/$(gid)).data;
    }

    function isMember(gid) {
      return signedIn() && request.auth.uid in groupData(gid).memberIds;
    }

    // Join: only my own uid is appended, with a token that points at this group.
    function onlyAddsSelf(gid) {
      let uid = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      return signedIn()
        && !(uid in before.memberIds)
        && after.memberIds == before.memberIds.concat([uid])
        && after.diff(before).affectedKeys().hasOnly(['memberIds', 'memberNames', 'joinToken'])
        && after.memberNames.diff(before.memberNames).affectedKeys().hasOnly([uid])
        && after.memberNames[uid] is string
        && after.joinToken is string
        && get(/databases/$(database)/documents/invites/$(after.joinToken)).data.groupId == gid;
    }

    function validName(n, max) {
      return n is string && n.size() >= 1 && n.size() <= max;
    }

    // Share keys must all be group members and there must be at least one.
    // (Per-value int/sum checks can't be written in rules; the client enforces sums.)
    function validShares(gid) {
      return request.resource.data.shares is map
        && request.resource.data.shares.size() > 0
        && request.resource.data.shares.keys().hasOnly(groupData(gid).memberIds);
    }

    function historyPath(gid, hid) {
      return /databases/$(database)/documents/groups/$(gid)/history/$(hid);
    }

    // An expense write must come with a brand-new history entry for it in the same batch.
    function validExpense(gid, eid) {
      let d = request.resource.data;
      return isMember(gid)
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time
        && d.amountFils is int
        && d.amountFils > 0
        && d.paidBy in groupData(gid).memberIds
        && d.historyId is string
        && d.deleted is bool
        && validShares(gid)
        && !exists(historyPath(gid, d.historyId))
        && existsAfter(historyPath(gid, d.historyId))
        && getAfter(historyPath(gid, d.historyId)).data.changedBy == request.auth.uid
        && getAfter(historyPath(gid, d.historyId)).data.expenseId == eid
        && getAfter(historyPath(gid, d.historyId)).data.action in ['create', 'update', 'delete']
        && d.deleted == (getAfter(historyPath(gid, d.historyId)).data.action == 'delete');
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName'])
        && validName(request.resource.data.displayName, 60);
    }

    match /groups/{gid} {
      allow get: if isMember(gid);
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid
        && validName(request.resource.data.name, 80);
      allow update: if (isMember(gid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && validName(request.resource.data.name, 80))
        || onlyAddsSelf(gid);

      match /expenses/{eid} {
        allow read: if isMember(gid);
        allow create, update: if validExpense(gid, eid);
        allow delete: if false;
      }

      // Entries exist only as the twin of an expense write that points at them.
      match /history/{hid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid)
          && request.resource.data.changedBy == request.auth.uid
          && request.resource.data.changedAt == request.time
          && getAfter(/databases/$(database)/documents/groups/$(gid)/expenses/$(request.resource.data.expenseId)).data.historyId == hid;
        allow update, delete: if false;
      }

      match /settlements/{sid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.auth.uid in [request.resource.data.fromUser, request.resource.data.toUser]
          && request.resource.data.fromUser != request.resource.data.toUser
          && request.resource.data.fromUser in groupData(gid).memberIds
          && request.resource.data.toUser in groupData(gid).memberIds
          && request.resource.data.amountFils is int
          && request.resource.data.amountFils > 0;
        allow update, delete: if false;
      }
    }

    match /invites/{token} {
      allow get: if signedIn();
      allow list: if false;
      // getAfter so the createGroup batch (group + invite) passes.
      allow create: if signedIn()
        && request.resource.data.groupId is string
        && request.auth.uid in getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberIds;
    }
  }
}
